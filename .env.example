APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Debug désactivé par défaut : stack traces et variables jamais exposées en production
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Chiffrement des données de session au repos (audit §P3-23)
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de session uniquement via HTTPS (OBLIGATOIRE en production derrière TLS)
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Intégrations externes ──
INTEGRATION_WEBHOOK_SECRET=
INTEGRATION_WEBHOOK_TOLERANCE=300
INTEGRATION_THROTTLE_API=60
INTEGRATION_THROTTLE_IMPORTS=5
INTEGRATION_THROTTLE_EXPORTS=10
INTEGRATION_THROTTLE_WEBHOOKS=30
INTEGRATION_QUEUE_THRESHOLD=500
INTEGRATION_EXPORT_RETENTION_HOURS=168

# ── Sécurité (audit §P0) ──
# Expiration des tokens API Sanctum en minutes (90 jours explicites)
SANCTUM_TOKEN_EXPIRATION=129600
# Préfixe des tokens (secret scanning / identification en logs — audit §P3-23)
SANCTUM_TOKEN_PREFIX=uniregistre
# Reconfirmation du mot de passe exigée après ce délai en secondes (1 h — audit §P3-23)
AUTH_PASSWORD_TIMEOUT=3600
# Reverse proxy de confiance ('*' ou liste CSV d'IPs) — requis en production
# derrière un load-balancer/TLS terminator pour un rate limiting et un audit IP fiables
# TRUSTED_PROXIES=*
# Durée de conservation des fichiers d'import (heures) avant purge (PII)
# INTEGRATION_IMPORT_RETENTION_HOURS=168
# Nombre maximal de lignes de données acceptées dans un fichier d'import
# INTEGRATION_IMPORT_MAX_ROWS=10000

# ── Scan CIN / Passeport + OCR (docs/IDENTITY-SCAN.md) ──
# Moteur OCR brut : 'null' = placeholder (repli saisie manuelle, défaut sûr)
#  | 'tesseract' | 'ppocr' | 'hfvlm'
# 'hfvlm' = VLM Qwen3-VL-4B-Instruct (MLX 4-bit, ~2,6 Go — très précis,
#   lent : ~20-60 s/appel, Apple Silicon ≥ 8 Go) ; même venv que ppocr :
#  python3 -m venv scripts/ocr/.venv &&
#  scripts/ocr/.venv/bin/pip install -r scripts/ocr/requirements.txt
# 'ppocr' = PaddleOCR via RapidOCR/ONNX, gabarit « server » par défaut
#   (det PP-OCRv5 server + rec PP-OCRv6 latin/en — ~4-8 s/appel ;
#   IDENTITY_PPOCR_MODELE=mobile pour l'ancien ~2-4 s/appel)
# 'tesseract' (macOS : brew install tesseract, puis ara.traineddata et
#  fra.traineddata dans /usr/local/share/tessdata — cf. docs §2)
IDENTITY_OCR_DRIVER=null
# IDENTITY_OCR_DRIVER=ppocr
# IDENTITY_OCR_DRIVER=tesseract
# IDENTITY_OCR_DRIVER=hfvlm
# Interrupteur IA — modèle VLM DÉSACTIVÉ par défaut (aucun téléchargement
# ni exécution du modèle ~2,6 Go, sortie non déterministe) : mettre à true
# pour activer explicitement le driver hfvlm (docs/IDENTITY-SCAN.md §hfvlm)
# IDENTITY_HFVLM_ENABLED=true
# Interpréteur/runner RapidOCR si emplacements différents
# IDENTITY_PPOCR_PYTHON=scripts/ocr/.venv/bin/python
# IDENTITY_PPOCR_SCRIPT=scripts/ocr/ppocr_runner.py
# Gabarit de modèles : server (défaut, précision max) | mobile (rapide)
# IDENTITY_PPOCR_MODELE=server
# Délai par appel en secondes (1er lancement « server » = ~220 Mo à télécharger)
# IDENTITY_PPOCR_TIMEOUT=180
# Tranche CPU forcée via `arch` (défaut : arm64 sur macOS, vide ailleurs —
# nécessaire si PHP est une build x86_64 sous Rosetta sur Mac Apple Silicon)
# IDENTITY_PPOCR_ARCH=arm64
# Driver VLM HF (venv + dépôt + délais + arch — idem ci-dessus)
# IDENTITY_HFVLM_PYTHON=scripts/ocr/.venv/bin/python
# IDENTITY_HFVLM_SCRIPT=scripts/ocr/hf_runner.py
# IDENTITY_HFVLM_MODEL=mlx-community/Qwen3-VL-4B-Instruct-4bit
# IDENTITY_HFVLM_TIMEOUT=300
# IDENTITY_HFVLM_ARCH=arm64
# Chemin du binaire tesseract si hors PATH
# IDENTITY_TESSERACT_BIN=tesseract
# Codes langues Tesseract pour le document (CIN tunisienne : arabe + français)
# IDENTITY_TESSERACT_LANGUE=ara+fra
# Mode de segmentation de page (3 = automatique)
# IDENTITY_TESSERACT_PSM=3
# Taille maximale des documents d'identité (octets, 8 Mo par défaut)
# IDENTITY_UPLOAD_MAX=8388608
# Rate limiting du scan (scans/minute/IP)
# IDENTITY_THROTTLE_SCAN=5
# Seuils de confiance OCR (pré-remplissage automatique / avertissement)
# IDENTITY_CONFIANCE_ELEVE=0.90
# IDENTITY_CONFIANCE_MOYEN=0.70

# Modules (architecture CORE + MODULES — voir docs/ARCHITECTURE-MODULES.md).
# Un module désactivé répond 404 et n'apparaît ni dans les menus ni dans les dashboards.
MODULE_ATTENDANCE=false
MODULE_STUDENT_DOSSIERS=false
MODULE_ONLINE_REQUESTS=false
MODULE_SCHEDULE=false
MODULE_REFERENTIEL=true
MODULE_ENSEIGNEMENT=true
MODULE_EVALUATION=false
MODULE_ANNOUNCEMENTS=false
MODULE_CALENDAR=false
MODULE_TASKS=false
MODULE_FINANCES=false
MODULE_STUDENT_ARCHIVE=false
MODULE_PARCOURS_ACADEMIQUE=false
MODULE_SENTINEL=false

# ── Sauvegardes chiffrées (A4 — roadmap 05/10/2026) ─────────────────
# Clé libsodium 32 octets en base64 : php -r "echo base64_encode(random_bytes(32));"
# Requise pour `sauvegarde:creer --chiffrer` et `sauvegarde:dechiffrer`.
# SECRET : coffre dédié, hors repository, hors sauvegardes applicatives.
SAUVEGARDE_CLE=

# ── Planning sauvegardes (défauts : actif, horaire) ─────────────────
# SAUVEGARDE_DESTINATION_EXTERNE=/chemin/hors/projet
# BACKUP_DESTINATION_DEFAULT=local_private
