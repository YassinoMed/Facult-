 * Périmètre restreint : AUDIT_ONLY / SIMULATION uniquement
 * Mutations et publications officielles bloquées
 * 
 * Ce test valide la cohérence métier entre les acquis pédagogiques
 * et l'éligibilité aux examens, selon les scénarios ACQ, EXM et CRO.
 */

use function Pest\Laravel\factory;

class LoopCampagneAcquisExamenTest extends TestCase
{
    use RefreshDatabase;

    /** @var string */
