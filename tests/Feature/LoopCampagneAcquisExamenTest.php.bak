    /** @var array */
    protected const MODES_AUTHORISES = ['AUDIT_ONLY', 'SIMULATION'];

    /**
     * Phase A — Audit: Inventaire des services, modèles, règles académiques
     *
     * @test
     */
    public function test_phase_a_audit_inventaire(): void
    {
        // Inventaire du service de calcul des acquis
        $service = app(\App\Services\Acquis\CalculAcquisPedagogiquesService::class);
        $this->assertNotNull($service);

        // Inventaire du service d'éligibilité aux examens
        $eligibilityService = app(\App\Modules\Evaluation\Services\ServiceEligibiliteExamen::class);
        $this->assertNotNull($eligibilityService);

        // Vérifier la présence des règles de régulation
        $reglementation = app(\App\Services\Acquis\ReglementationAcquisService::class);
        $this->assertNotNull($reglementation);

        // Vérifier les modèles impliqués
        $this->assertTrue(class_exists(\App\Models\Etudiant::class));
        $this->assertTrue(class_exists(\App\Models\InscriptionAcademique::class));
        $this->assertTrue(class_exists(\App\Modules\Evaluation\Models\Examen::class));
        $this->assertTrue(class_exists(\App\Modules\Evaluation\Models\Epreuve::class));
        $this->assertTrue(class_exists(\App\Modules\Evaluation\DTO\DecisionEligibiliteExamen::class));
    }

