    /**
     * CRITÈRE 7 : Toutes les décisions sont traçables et reproductibles.
     */
    protected function testerDecisionsTraçablesEtReproductibles(): bool
    {
        // Tester avec des modèles réels (créés dans la base de données)
        // Toutes les décisions d'éligibilité doivent contenir :
        // - La décision (éligible/non_eligible/anomalie)
        // - La source de la décision
        // - La règle appliquée
        // - Le motif explicatif
        // - La date d'évaluation
        
        // Récupérer ou créer une matière
        $matiere = \App\Models\Matiere::first();
        if ($matiere === null) {
            $matiere = \App\Models\Matiere::create([
                'code' => 'TEST01',
                'nom' => 'Matière de test',
                'credits' => 6,
                'coefficient' => 2,
                'niveau' => 'L1',
                'semestre' => 'S1',
                'actif' => true,
            ]);
        }
        
        // Récupérer ou créer une annee universitaire
        $annee = \App\Models\AnneeUniversitaire::first();
        if ($annee === null) {
            $annee = \App\Models\AnneeUniversitaire::create([
                'libelle' => '2025-2026',
                'date_debut' => '2025-09-01',
                'date_fin' => '2026-06-30',
                'active' => true,
            ]);
        }
        
        // Récupérer ou créer une session examen
        $session = \App\Modules\Evaluation\Models\SessionExamen::where('annee_universitaire_id', $annee->id)
            ->where('type', 'normale')
            ->first();
        
        if ($session === null) {
            $session = \App\Modules\Evaluation\Models\SessionExamen::create([
                'code' => 'NORM-2025',
                'type' => 'normale',
                'annee_universitaire_id' => $annee->id,
                'nom' => 'Session normale 2025-2026',
                'date_debut' => '2025-09-01',
                'date_fin' => '2026-06-30',
                'active' => true,
            ]);
        }
        
        // Récupérer ou créer une epreuve
        $epreuve = \App\Modules\Evaluation\Models\Epreuve::where('matiere_id', $matiere->id)
            ->where('session_id', $session->id)
            ->first();
        
        if ($epreuve === null) {
            $epreuve = \App\Modules\Evaluation\Models\Epreuve::create([
                'code' => 'EPR-TEST01',
                'examen_id' => 1,
                'matiere_id' => $matiere->id,
                'session_id' => $session->id,
                'annee_universitaire_id' => $annee->id,
                'date' => '2025-12-15',
                'heure_debut' => '09:00',
                'heure_fin' => '11:00',
                'duree_minutes' => 120,
                'type_evaluation' => 'examen',
                'coefficient' => 2.0,
                'bareme' => 20.0,
                'note_max' => 20.0,
                'capacite_necessaire' => 50,
                'statut' => 'planned',
                'active' => true,
            ]);
        }
        
        // Créer ou récupérer un étudiant
        $etudiant = \App\Models\Etudiant::first();
        if ($etudiant === null) {
            $etudiant = \App\Models\Etudiant::factory()->create();
        }
        
        // Créer ou récupérer inscription académique active
        $inscriptionAcad = \App\Models\InscriptionAcademique::where('etudiant_id', $etudiant->id)
            ->where('annee_universitaire_id', $annee->id)
            ->whereIn('statut', ['en_cours', 'valide', 'inscrit'])
            ->first();
        
        if ($inscriptionAcad === null) {
            $inscriptionAcad = \App\Models\InscriptionAcademique::create([
                'etudiant_id' => $etudiant->id,
                'annee_universitaire_id' => $annee->id,
                'statut' => 'inscrit',
                'niveau_id' => 1,
            ]);
        }
        
        // Créer ou récupérer inscription pédagogique active
        $inscriptionPed = \App\Modules\Evaluation\Models\InscriptionPedagogique::where('etudiant_id', $etudiant->id)
            ->where('matiere_id', $matiere->id)
            ->where('statut', 'inscrit')
            ->first();
        
        if ($inscriptionPed === null) {
            $groupe = \App\Modules\Schedule\Models\Group::first();
            if ($groupe === null) {
                $groupe = \App\Modules\Schedule\Models\Group::create([
                    'name' => 'G-TEST',
                    'faculte_id' => null,
                ]);
            }
            $inscriptionPed = \App\Modules\Evaluation\Models\InscriptionPedagogique::create([
                'inscription_id' => $inscriptionAcad->id,
                'matiere_id' => $matiere->id,
                'groupe_id' => $groupe->id,
                'statut' => 'inscrit',
            ]);
        }
        
        // Mettre à jour l'épreuve avec les références correctes
        $epreuve->matiere_id = $matiere->id;
        $epreuve->annee_universitaire_id = $annee->id;
        $epreuve->session_id = $session->id;
        $epreuve->save();
        
        // Évaluer l'étudiant
        $decision = app(\App\Modules\Evaluation\Services\ServiceEligibiliteExamen::class)->evaluer($epreuve, $etudiant);
        
        // Vérifier que la décision contient toutes les informations nécessaires
        $requis = ['decision', 'source', 'regle', 'motif', 'evalueLe'];
        $decisionArray = $decision->toArray();
        
        foreach ($requis as $cle) {
            if (!array_key_exists($cle, $decisionArray)) {
                \Log::warning("Critère 7 manquant : {$cle} non présent dans la décision");
                return false;
            }
        }
        
        // Vérifier les types de valeurs
        if (!is_string($decisionArray['decision'])) {
            return false;
        }
        if (!is_string($decisionArray['source'])) {
            return false;
        }
        if (!is_string($decisionArray['regle'])) {
            return false;
        }
        if (!is_string($decisionArray['motif'])) {
            return false;
        }
        if (!isset($decisionArray['evalueLe'])) {
            return false;
        }
        
        return true;
    }

    /**
     * Déterminer le verdict final basée sur les critères indépendants.
     *
     * @return string
     */
    protected function determinerVerdict(array $criteria): string
    {
        // Vérifier si un critère critique a échoué (false)
        $critiquesEchoues = array_filter($criteria, fn ($v) => $v === false);

        if (count($critiquesEchoues) > 0) {
            return 'FAIL';
        }

        // Vérifier s'il y a des réserves (true mais avec warnings)
        // Ici, on considère qu'une réserve signifie que des avertissements ont été détectés
        // mais que les critères critiques sont tout de même satisfaits
        $aVoir = array_filter($criteria, fn ($v) => $v !== true && $v !== false);

        if (count($aVoir) > 0) {
            return 'PASS_WITH_RESERVATIONS';
        }

        // Tous les critères sont satisfaits
        return 'PASS';
    }

