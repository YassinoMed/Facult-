<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <!-- Locale de test = fr (21/10) : le projet est francophone et
             lang/fr/validation.php existe ; la suite de tests attend des
             messages en français. Le .env local fixe déjà APP_LOCALE=fr,
             mais la CI (sans .env) héritait du défaut 'en' de config/app.php
             → « The code field must be 6 digits. » au lieu de « 6 chiffres »
             (VerrouillageSecondaireTest : test_erreurs_pin_en_francais).
             phpunit.xml prime sur .env (Dotenv immutable) → local = CI.
             config/app.php reste inchangé (défaut applicatif 'en'). -->
        <env name="APP_LOCALE" value="fr"/>
        <env name="APP_FALLBACK_LOCALE" value="fr"/>
        <!-- AC-00c (13/10) : clé de TEST dédiée (jamais un secret de prod) —
             indispensable en CI où aucun .env n'existe : sans APP_KEY, le
             chiffrement des cookies (EncryptCookies) fait échouer toute
             requête web (preuve du 12/10 : No application encryption key). -->
        <env name="APP_KEY" value="base64:cEEQkqU0+f4TM46pWBnp19dlQnCzjLF0eQn1GpiQPzA="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- AC-00c (13/10) : contrat d'environnement de tests — les modules
             que la suite couvre doivent être EXPLICITEMENT actifs : sans
             .env (CI), les défauts config/modules.php (false) rendaient
             404 toute route module:xxx (run CI 38347795151 : 17 échecs).
             phpunit.xml prime sur .env (Dotenv immutable) — local = CI. -->
        <env name="MODULE_ATTENDANCE" value="true"/>
        <env name="MODULE_STUDENT_DOSSIERS" value="true"/>
        <env name="MODULE_ONLINE_REQUESTS" value="true"/>
        <env name="MODULE_SCHEDULE" value="true"/>
        <env name="MODULE_EVALUATION" value="true"/>
        <env name="MODULE_SENTINEL" value="true"/>
    </php>
</phpunit>
